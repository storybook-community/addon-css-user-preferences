{
  "name": "@storybook-community/addon-css-user-preferences",
  "version": "0.0.3",
  "description": "Emulate CSS user preferences in Storybook",
  "keywords": [
    "storybook-addons",
    "conditions",
    "css",
    "emulate",
    "emulates",
    "emulation",
    "media",
    "query",
    "queries",
    "preferences",
    "prefers-color-scheme",
    "prefers-contrast",
    "prefers-reduced-data",
    "prefers-reduced-motion",
    "prefers-reduced-transparency",
    "prefs",
    "toolbar",
    "user",
    "storybook-addons"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/storybook-community/addon-css-user-preferences"
  },
  "author": "Jonathan Neal <jonathantneal@hotmail.com>",
  "license": "CC0-1.0",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./manager": {
      "default": "./dist/manager.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "*.js"
  ],
  "scripts": {
    "build": "tsdown",
    "build:watch": "pnpm build --watch",
    "clean": "rimraf dist coverage storybook-static",
    "cs": "changeset",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "w": "vitest",
    "cov": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "playwright:i": "playwright install --with-deps chromium",
    "verify": "run-s check build test",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "dependencies": {
    "polished": "^4.3.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@repobuddy/storybook": "^2.32.1",
    "@storybook-community/storybook-dark-mode": "^7.1.3",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "dedent": "^1.7.2",
    "npm-run-all2": "^9.0.3",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "rimraf": "^6.1.3",
    "storybook": "^10.5.10",
    "storybook-addon-tag-badges": "^3.1.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-browser-react": "^2.2.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "storybook": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "storybook": {
    "displayName": "Emulate CSS user preferences in Storybook",
    "supportedFrameworks": [
      "react",
      "vue",
      "angular",
      "web-components",
      "ember",
      "html",
      "svelte",
      "preact",
      "react-native"
    ],
    "icon": "https://user-images.githubusercontent.com/321738/63501763-88dbf600-c4cc-11e9-96cd-94adadc2fd72.png"
  },
  "bundler": {
    "managerEntries": [
      "./src/manager.ts"
    ],
    "previewEntries": [
      "./src/preview.ts",
      "./src/index.ts"
    ],
    "nodeEntries": []
  }
}
